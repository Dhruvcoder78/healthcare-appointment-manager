# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# PostgreSQL / Prisma
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/healthcare_appointments?schema=public"

# JWT Auth
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# OpenAI (or compatible LLM) for clinical summaries
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Brevo (HTTP API, not SMTP) for notifications. Raw SMTP is deliberately
# not used — many hosts (Render included) block outbound SMTP ports
# (25/465/587) to prevent spam abuse, which makes Nodemailer/SMTP time out
# no matter which provider or port you point it at. An HTTPS API call is
# unaffected by that block. Brevo over Resend specifically because Brevo
# only requires verifying a single sender email (Settings -> Senders,
# Domains & Dedicated IPs) rather than a whole domain, and doesn't restrict
# which recipients you can send to on the free tier.
BREVO_API_KEY=your_brevo_api_key
BREVO_FROM=your_verified_sender@example.com
BREVO_FROM_NAME="Healthcare Appointment Manager"

# Google Calendar API (OAuth 2.0)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/calendar/oauth/callback

# Background jobs
MEDICATION_REMINDER_CRON="*/15 * * * *"
EMAIL_RETRY_CRON="*/10 * * * *"
APPOINTMENT_REMINDER_CRON="0 * * * *"
