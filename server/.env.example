# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# PostgreSQL / Prisma
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/healthcare_appointments?schema=public"

# JWT Auth
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# OpenAI (or compatible LLM) for clinical summaries
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# SMTP / Nodemailer for notifications
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM="Healthcare Appointment Manager <no-reply@example.com>"

# Google Calendar API (OAuth 2.0)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/calendar/oauth/callback

# Background jobs
MEDICATION_REMINDER_CRON="*/15 * * * *"
EMAIL_RETRY_CRON="*/10 * * * *"
APPOINTMENT_REMINDER_CRON="0 * * * *"
